# Independent Firebase Project (Authentication + Firestore only)
# Copy this file to .env and fill in your values. Never commit .env.
# NEVER expose Firebase Admin SDK credentials or Cloudinary API Secrets in VITE_* variables.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Cloudinary Media Upload Configuration (Unsigned preset for local testing)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
